generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? vehicles Vehicle[] trips Trip[] savedPlans SavedPlan[] createdAt DateTime @default(now()) }
model Vehicle { id String @id @default(cuid()) userId String manufacturer String model String year Int engine String fuelType String tankCapacity Float averageConsumption Float highwayConsumption Float cityConsumption Float user User @relation(fields:[userId], references:[id]) trips Trip[] }
model Trip { id String @id @default(cuid()) userId String vehicleId String from String to String etd DateTime eta DateTime eteMinutes Int distanceKm Float status String @default("DRAFT") user User @relation(fields:[userId], references:[id]) vehicle Vehicle @relation(fields:[vehicleId], references:[id]) route Route? fuelPlan FuelPlan? savedPlans SavedPlan[] createdAt DateTime @default(now()) }
model Route { id String @id @default(cuid()) tripId String @unique encodedPolyline String? trip Trip @relation(fields:[tripId], references:[id]) legs RouteLeg[] weatherPoints WeatherPoint[] fuelStations FuelStation[] hazards RoadHazard[] }
model RouteLeg { id String @id @default(cuid()) routeId String sequence Int from String to String distanceKm Float heading Int altitudeM Int wind String airTempC Float roadTempC Float roadCondition String fuelL Float eta DateTime route Route @relation(fields:[routeId], references:[id]) }
model WeatherPoint { id String @id @default(cuid()) routeId String km Float lat Float lon Float airTempC Float windDirection Int windSpeedMs Float gustMs Float precipitationProbability Int roadSurfaceTempC Float pressureHpa Float cloudCover Int route Route @relation(fields:[routeId], references:[id]) }
model FuelPlan { id String @id @default(cuid()) tripId String @unique tripFuelL Float reserveFuelL Float extraFuelL Float totalRequiredL Float fuelOnBoardL Float remainingL Float trip Trip @relation(fields:[tripId], references:[id]) }
model FuelStation { id String @id @default(cuid()) routeId String name String distanceKm Float fuelType String price Float? openingHours String? fuelRemainingBeforeStopL Float recommendedRefuelL Float lat Float lon Float route Route @relation(fields:[routeId], references:[id]) }
model RoadHazard { id String @id @default(cuid()) routeId String type String severity String description String km Float startsAt DateTime? endsAt DateTime? route Route @relation(fields:[routeId], references:[id]) }
model SavedPlan { id String @id @default(cuid()) userId String tripId String title String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) trip Trip @relation(fields:[tripId], references:[id]) }
